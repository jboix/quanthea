{
  "name": "@quanthea/plugin-kit",
  "version": "0.0.0",
  "private": true,
  "description": "The connector kit: the types a quanthea connector plugin is written against, a test kit and the conformance suite.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./host": "./src/host.ts",
    "./contract": "./src/contract.ts"
  },
  "scripts": {
    "dist": "bun scripts/dist.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "release:ci": "semantic-release"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@semantic-release/exec": "^7.1.0",
    "semantic-release": "^25.0.9",
    "semantic-release-monorepo": "^8.0.2"
  }
}
