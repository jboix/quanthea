{
  "name": {{{json name}}},
  "version": "0.1.0",
  "description": {{{json description}}},
  "keywords": [
    "quanthea-plugin",
    "quanthea"
  ],
  "license": "MIT",
  "author": {{{json author}}},
  "type": "module",
  "files": [
    "dist"
  ],
  "quanthea": {
    "kitVersion": 0,
    "main": "dist/plugin.js"
  },
  "scripts": {
    "build": "bun build src/plugin.ts --outfile dist/plugin.js --target bun --format esm",
    "prepack": "bun run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": {{{json versions.biome}}},
    "@quanthea/plugin-kit": {{{json kit}}},
    "@types/bun": {{{json versions.typesBun}}},
    "typescript": {{{json versions.typescript}}}
  }
}
