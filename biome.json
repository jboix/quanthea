{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!**/dist", "!**/coverage"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 8
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 25,
            "skipBlankLines": true
          }
        }
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "error",
        "noUndeclaredDependencies": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error"
      },
      "style": {
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 400
          }
        },
        "useImportType": "error",
        "useExportType": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noDefaultExport": "error",
        "useConst": "error",
        "useTemplate": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"]
          }
        },
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "Function": "No model-written code runs. Use a named formatter instead.",
              "eval": "No model-written code runs. Use a named formatter instead."
            }
          }
        }
      },
      "security": {
        "noDangerouslySetInnerHtml": "error",
        "noGlobalEval": "error"
      },
      "nursery": {
        "noImpliedEval": "error"
      }
    },
    "domains": {
      "react": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.config.ts", "**/*.config.js", "**/*.config.mjs", ".remarkrc.mjs"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/remark-check-formatted.mjs", "examples/*/src/plugin.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/create-plugin/src/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Function": "No model-written code runs. Use a named formatter instead.",
                  "eval": "No model-written code runs. Use a named formatter instead.",
                  "Bun": "The generator runs on Node, from npm create: use node: modules."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/server/src/**", "!apps/server/src/db/**", "!apps/server/src/agent/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "bun:sqlite": "Only apps/server/src/db/ talks to bun:sqlite. Use a repository.",
                  "ai": "The model SDK is an implementation detail of apps/server/src/agent/."
                },
                "patterns": [
                  {
                    "group": ["@ai-sdk/*"],
                    "message": "The model SDK is an implementation detail of apps/server/src/agent/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/server/src/agent/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "bun:sqlite": "Only apps/server/src/db/ talks to bun:sqlite. Use a repository."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/server/src/db/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "ai": "The model SDK is an implementation detail of apps/server/src/agent/."
                },
                "patterns": [
                  {
                    "group": ["@ai-sdk/*"],
                    "message": "The model SDK is an implementation detail of apps/server/src/agent/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/server/src/**",
        "!apps/server/src/notifications/notifications.ts",
        "!apps/server/src/settings/gateway-fetch.ts",
        "!apps/server/src/auth/providers/drivers.ts",
        "!apps/server/src/plugins/**",
        "!apps/server/src/cli.ts",
        "!apps/server/src/connectors/_shared/http.ts",
        "!**/*.test.ts",
        "!**/test/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Function": "No model-written code runs. Use a named formatter instead.",
                  "eval": "No model-written code runs. Use a named formatter instead.",
                  "fetch": "Outbound calls go through a checked client: createHttpClient, the gateway fetch, or a channel's send."
                }
              }
            }
          },
          "nursery": {
            "noJsRestrictedProperties": {
              "level": "error",
              "options": {
                "entries": [
                  {
                    "object": "globalThis",
                    "property": "fetch",
                    "message": "Outbound calls go through a checked client: createHttpClient, the gateway fetch, or a channel's send."
                  },
                  {
                    "object": "Bun",
                    "property": "fetch",
                    "message": "Outbound calls go through a checked client: createHttpClient, the gateway fetch, or a channel's send."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Function": "No model-written code runs. Use a named formatter instead.",
                  "eval": "No model-written code runs. Use a named formatter instead.",
                  "open": "Navigate with React Router; a link opens a new tab with target and rel."
                }
              }
            }
          },
          "nursery": {
            "noJsRestrictedProperties": {
              "level": "error",
              "options": {
                "entries": [
                  {
                    "object": "window",
                    "property": "open",
                    "message": "Navigate with React Router; a link opens a new tab with target and rel."
                  },
                  {
                    "object": "globalThis",
                    "property": "open",
                    "message": "Navigate with React Router; a link opens a new tab with target and rel."
                  },
                  {
                    "object": "self",
                    "property": "open",
                    "message": "Navigate with React Router; a link opens a new tab with target and rel."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/server/src/connectors/**",
        "!apps/server/src/connectors/_shared/http.ts",
        "!**/*.test.ts",
        "!**/test/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Function": "No model-written code runs. Use a named formatter instead.",
                  "eval": "No model-written code runs. Use a named formatter instead.",
                  "fetch": "Connectors call HTTP through createHttpClient from the connector kit."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/test/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noExcessiveLinesPerFunction": "off"
          },
          "style": {
            "noExcessiveLinesPerFile": "off",
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ],
  "html": {
    "experimentalFullSupportEnabled": true
  }
}
