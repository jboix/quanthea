{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["dot"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"]
    },
    "apps/server": {
      "entry": ["src/main.ts", "src/cli.ts", "src/provisioning/write-schema.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    },
    "dev": {
      "entry": ["metrics/history.ts", "metrics/serve.ts", "seed/seed.ts"],
      "project": ["metrics/**/*.ts", "seed/**/*.ts"]
    }
  }
}
