{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["dot"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "ignoreDependencies": ["conventional-changelog-conventionalcommits"]
    },
    "apps/server": {
      "entry": ["src/main.ts", "src/cli.ts", "src/provisioning/write-schema.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    },
    "packages/plugin-kit": {
      "entry": ["scripts/consumer.ts"],
      "ignoreDependencies": ["@semantic-release/exec", "semantic-release-monorepo"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/create-plugin": {
      "entry": ["src/cli.ts", "scripts/*.ts"],
      "ignoreDependencies": ["@semantic-release/exec", "semantic-release-monorepo"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "examples/quanthea-plugin-sqlite": {
      "entry": ["src/plugin.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "evals": {
      "entry": ["run.ts"],
      "project": ["*.ts"]
    },
    "dev": {
      "entry": [
        "metrics/history.ts",
        "metrics/serve.ts",
        "seed/seed.ts",
        "demo/start.ts",
        "refresh.ts",
        "log-seed/seed-search.ts",
        "log-seed/seed-loki.ts",
        "http-api/serve.ts",
        "influxdb/seed.ts",
        "valkey/seed.ts",
        "mongodb/seed.ts"
      ],
      "project": [
        "metrics/**/*.ts",
        "seed/**/*.ts",
        "demo/**/*.ts",
        "*.ts",
        "log-seed/**/*.ts",
        "http-api/**/*.ts",
        "influxdb/**/*.ts",
        "valkey/**/*.ts",
        "mongodb/**/*.ts"
      ]
    }
  }
}
