---
/**
 * A docs page of one version: the sidebar and the search of that version, its picker, a banner on
 * `next` and on older releases, the doc itself with its title, and the table of contents from its
 * `##` and `###` headings. Pages of `next` and of older releases name the latest's as canonical.
 */
import type { MarkdownHeading } from 'astro';
import '../styles/prose.css';
import DocsMenu from '../components/docs-menu.astro';
import DocsSearch from '../components/docs-search.astro';
import DocsSidebar from '../components/docs-sidebar.astro';
import DocsVersions from '../components/docs-versions.astro';
import { allVersions, docPages } from '../lib/docs-content.ts';
import { docBreadcrumbs } from '../lib/structured-data.ts';
import { link } from '../lib/url.ts';
import type { DocVersion } from '../lib/versions.ts';
import Base from './base.astro';

/** Props of a docs page. */
interface Props {
  /** The page's slug under `docs/`, or `undefined` for the docs index. */
  slug?: string;
  /** The title. */
  title: string;
  /** The description. */
  description: string;
  /** The headings of the page, for the table of contents. */
  headings?: readonly MarkdownHeading[];
  /** The version of the docs the page belongs to. */
  version: DocVersion;
}

const { slug, title, description, headings = [], version } = Astro.props;
const versions = allVersions();
const slugsOf = new Map(
  await Promise.all(
    versions.map(async (each) => [each.id, (await docPages(each)).map((page) => page.slug)] as const),
  ),
);
/** Where a version leads from this page: the same page, or its docs home when it lacks it. */
const hrefIn = (each: DocVersion) =>
  link(slug !== undefined && slugsOf.get(each.id)?.includes(slug) ? `${each.path}${slug}/` : each.path);
const links = versions.map((each) => ({ version: each, href: hrefIn(each) }));
const latest = versions.find((each) => each.latest) ?? version;
const shownTitle = version.latest ? title : `${title} (${version.id})`;
// Another version's page stands for itself only when the latest release lacks it.
const inLatest = slug === undefined || slugsOf.get(latest.id)?.includes(slug) === true;
const canonicalPath = version.latest || !inLatest ? undefined : `${latest.path}${slug ?? ''}${slug ? '/' : ''}`;
const breadcrumbs =
  slug === undefined ? undefined : docBreadcrumbs(Astro.site, shownTitle, `${version.path}${slug}/`);
const bundle = `${version.latest ? '' : version.path}pagefind/`;
const contents = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<Base
  title={shownTitle}
  description={description}
  type="article"
  current="docs"
  {...breadcrumbs === undefined ? {} : { jsonLd: breadcrumbs }}
  {...canonicalPath === undefined ? {} : { canonicalPath }}
>
  <slot name="head" slot="head" />
  <DocsSearch slot="header-search" bundle={bundle} />
  <DocsMenu slot="header-menu" current={slug} path={version.path} slugs={slugsOf.get(version.id)} />
  <div class="container docs-shell">
    <DocsSidebar current={slug} path={version.path} slugs={slugsOf.get(version.id)} />
    <div class="docs-main">
      <article class="doc" data-pagefind-body>
        <div class="crumbs" data-pagefind-ignore>
          <a href={link(version.path)}>Docs</a>
          <DocsVersions current={version} links={links} />
        </div>
        {
          !version.latest && (
            <p class="version-banner" role="note" data-pagefind-ignore>
              {version.next
                ? 'These docs follow main: they describe changes no release has yet.'
                : `These docs describe ${version.id}, an older release.`}{' '}
              <a href={hrefIn(latest)}>
                {inLatest ? 'Read this page in the latest release' : 'Read the latest release’s docs'}
              </a>
            </p>
          )
        }
        <h1>{title}</h1>
        <div class="prose">
          <slot />
        </div>
      </article>
    </div>
    {
      contents.length > 0 && (
        <nav class="toc" aria-labelledby="toc-title">
          <h2 id="toc-title">On this page</h2>
          <ul>
            {contents.map((heading) => (
              <li class={`depth-${heading.depth}`}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</Base>

<style>
  .docs-shell {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) 220px;
    gap: 48px;
    align-items: start;
    padding-top: 32px;
  }

  .docs-main {
    min-width: 0;
  }

  .doc h1 {
    font-size: clamp(1.9rem, 4vw, 2.5rem);
    margin-bottom: 24px;
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 8px;
    font-size: 14px;
  }

  .version-banner {
    margin: 0 0 16px;
    padding: 10px 14px;
    border: 1px solid var(--color-draft-border);
    border-radius: var(--radius-card);
    background: var(--color-draft-soft);
    font-size: 14px;
  }

  .crumbs a {
    color: var(--color-ink-secondary);
  }

  .toc {
    position: sticky;
    top: 88px;
    max-height: calc(100vh - 112px);
    overflow-y: auto;
    font-size: 13px;
  }

  .toc h2 {
    font-size: 13px;
    color: var(--color-ink-secondary);
    font-weight: 600;
    margin-bottom: 8px;
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--color-border);
  }

  .toc li {
    margin: 0;
  }

  .toc a {
    display: block;
    padding: 3px 0 3px 12px;
    color: var(--color-ink-secondary);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--color-ink);
  }

  .toc .depth-3 a {
    padding-left: 24px;
  }

  @media (max-width: 1180px) {
    .docs-shell {
      grid-template-columns: 200px minmax(0, 1fr);
    }

    .toc {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .docs-shell {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
      padding-top: 16px;
    }
  }
</style>

<script>
  import { addCopyButtons } from '../scripts/copy-code.ts';

  addCopyButtons(document.querySelectorAll<HTMLPreElement>('.prose pre'));
</script>
