---
/**
 * The docs sidebar, on wide screens. On narrow ones the header's menu holds the docs instead.
 */
import DocsNavList from './docs-nav-list.astro';

/** Props of the sidebar. */
interface Props {
  /** The slug of the page shown. */
  current?: string | undefined;
  /** The site path of the version's docs, such as `docs/` or `docs/v0.3/`. */
  path?: string | undefined;
  /** The pages the version has. */
  slugs?: readonly string[] | undefined;
}

const { current, path, slugs } = Astro.props;
---

<nav class="docs-sidebar" aria-label="Docs">
  <DocsNavList current={current} path={path} slugs={slugs} />
</nav>

<style>
  .docs-sidebar {
    position: sticky;
    top: 88px;
    font-size: 14px;
  }

  @media (max-width: 860px) {
    .docs-sidebar {
      display: none;
    }
  }
</style>
