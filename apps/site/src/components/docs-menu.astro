---
/**
 * The docs' menu on a narrow screen: a button in the header that opens a panel from the right,
 * with the site's links, then every doc. A native dialog keeps focus inside, closes on Escape and
 * dims the page behind it. On a wide screen the sidebar shows the docs and the button hides.
 */
import { repositoryUrl } from '../lib/project.ts';
import { link } from '../lib/url.ts';
import DocsNavList from './docs-nav-list.astro';

/** Props of the menu. */
interface Props {
  /** The slug of the page shown. */
  current?: string | undefined;
  /** The site path of the version's docs, such as `docs/` or `docs/v0.3/`. */
  path?: string | undefined;
  /** The pages the version has. */
  slugs?: readonly string[] | undefined;
}

const { current, path, slugs } = Astro.props;
---

<button
  type="button"
  class="menu-toggle"
  aria-label="Menu"
  aria-haspopup="dialog"
  aria-controls="docs-menu"
  data-menu-open
>
  <svg
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M4 7h16 M4 12h16 M4 17h16"></path>
  </svg>
</button>
<dialog class="docs-drawer" id="docs-menu" aria-label="Menu">
  <div class="drawer-body">
  <div class="drawer-head">
    <span class="drawer-title">Menu</span>
    <button type="button" class="drawer-close" aria-label="Close the menu" data-menu-close>
      <svg
        viewBox="0 0 16 16"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M3.5 3.5l9 9M12.5 3.5l-9 9"></path>
      </svg>
    </button>
  </div>
  <nav aria-label="Site">
    <ul class="site-links">
      <li><a href={link('#features')}>Features</a></li>
      <li><a href={link('docs/')}>Docs</a></li>
      <li><a href={link('pricing/')}>Pricing</a></li>
      <li><a href={repositoryUrl}>GitHub</a></li>
    </ul>
  </nav>
  <nav class="drawer-docs" aria-label="Docs">
    <DocsNavList current={current} path={path} slugs={slugs} />
  </nav>
  </div>
</dialog>

<style>
  .menu-toggle {
    display: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
    background: var(--color-surface);
    color: var(--color-ink-secondary);
    cursor: pointer;
  }

  .menu-toggle:hover {
    color: var(--color-ink);
    border-color: var(--color-border-control);
  }

  .docs-drawer {
    width: min(320px, 86vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0 0 0 auto;
    padding: 0;
    overflow: auto;
    border: 0;
    border-left: 1px solid var(--color-border);
    background: var(--color-ground);
    color: var(--color-ink);
    font-size: 15px;
  }

  /* The padding is the body's, so a press on the dialog itself is a press outside the panel. */
  .drawer-body {
    min-height: 100%;
    padding: 0 20px 24px;
  }

  .docs-drawer::backdrop {
    background: color-mix(in srgb, var(--color-ink) 35%, transparent);
  }

  .drawer-head {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    background: var(--color-ground);
  }

  .drawer-title {
    font-weight: 600;
  }

  .drawer-close {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--color-ink-secondary);
    cursor: pointer;
  }

  .drawer-close:hover {
    background: var(--color-surface-muted);
    color: var(--color-ink);
  }

  .site-links {
    display: grid;
    gap: 2px;
    margin: 0 0 16px;
    padding: 0 0 16px;
    border-bottom: 1px solid var(--color-border);
    list-style: none;
  }

  .site-links a {
    display: block;
    padding: 8px 0;
    color: var(--color-ink);
    font-weight: 500;
    text-decoration: none;
  }

  @media (max-width: 860px) {
    .menu-toggle {
      display: inline-grid;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#docs-menu');
  document.querySelector('[data-menu-open]')?.addEventListener('click', () => dialog?.showModal());
  document.querySelector('[data-menu-close]')?.addEventListener('click', () => dialog?.close());
  // A press on the dimmed page, outside the panel, closes it.
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
