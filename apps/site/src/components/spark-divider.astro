---
/**
 * A section divider drawn as a chart's smoothed series: a soft area under a thin accent line on a
 * baseline, fading out at both ends. It draws itself when it scrolls into view.
 */
import { smoothAreaPath, smoothPath, sparkValues } from '../lib/chart-geometry.ts';

/** Props of the divider. */
interface Props {
  /** Picks the line's shape; each divider takes another seed. */
  seed: number;
}

const { seed } = Astro.props;
const plot = { left: 0, right: 1000, top: 8, bottom: 56 };
const values = sparkValues(seed, 24);
const line = smoothPath(values, plot, [0, 1]);
const area = smoothAreaPath(values, plot, [0, 1]);
---

<div class="container divider" aria-hidden="true" data-draw>
  <svg viewBox="0 0 1000 56" preserveAspectRatio="none" aria-hidden="true">
    <path class="area" d={area}></path>
    <line class="base" x1="0" x2="1000" y1="55.5" y2="55.5"></line>
    <path class="draw" d={line} pathLength="1" vector-effect="non-scaling-stroke"></path>
  </svg>
</div>

<style>
  .divider {
    margin-block: 16px;
  }

  svg {
    display: block;
    width: 100%;
    height: 56px;
    overflow: visible;
    mask-image: linear-gradient(to right, transparent, black 18%, black 82%, transparent);
  }

  .area {
    fill: var(--color-accent);
    opacity: 0.07;
  }

  .base {
    stroke: var(--color-border);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .draw {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.5;
    opacity: 0.55;
  }

  :global(:root[data-motion="on"]) .draw {
    stroke-dasharray: 1;
    transition: stroke-dashoffset 1.4s ease-out;
  }

  :global(:root[data-motion="on"]) .divider:not(.is-drawn) .draw {
    stroke-dashoffset: 1;
  }
</style>
