---
/**
 * Every data source quanthea reads, from `facts.ts`, as a grid of tiles with each source's icon and
 * name, and a last tile for the ones you write yourself.
 */
import { connectors } from '../data/facts.ts';
import { connectorIcon } from '../lib/connector-icons.ts';
import { link } from '../lib/url.ts';

const tiles = connectors.map((connector) => ({ ...connector, icon: connectorIcon(connector.name) }));
---

<section class="container section" aria-labelledby="sources-title">
  <h2 id="sources-title">Data sources</h2>
  <p class="lead">
    {connectors.length} sources out of the box, read with read-only credentials.
  </p>
  <ul class="wall">
    {
      tiles.map((tile) => (
        <li>
          {tile.icon && (
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" class={tile.icon.style}>
              <path d={tile.icon.path} />
            </svg>
          )}
          <span class="mono">{tile.name}</span>
        </li>
      ))
    }
    <li class="own">
      <a href={link('docs/connectors/')}>+ your own, as a plugin</a>
    </li>
  </ul>
</section>

<style>
  .section {
    padding-block: 72px;
  }

  h2 {
    font-size: clamp(1.7rem, 3vw, 2.2rem);
  }

  .lead {
    color: var(--color-ink-secondary);
    margin-bottom: 28px;
  }

  .wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(184px, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  li {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    padding: 12px 18px;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
    font-size: 15px;
  }

  svg {
    flex: none;
    color: var(--color-ink-label);
  }

  svg.fill {
    fill: currentColor;
  }

  svg.stroke {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The last tile takes two cells, so its words stay on one line. */
  .own {
    grid-column: span 2;
    white-space: nowrap;
    background: var(--color-accent-soft);
  }

  @media (max-width: 480px) {
    .wall {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    li {
      gap: 8px;
      padding: 10px 12px;
      font-size: 13px;
    }

    .own {
      grid-column: 1 / -1;
    }
  }

  .own a {
    font-weight: 500;
    text-decoration: none;
  }

  .own a:hover {
    text-decoration: underline;
  }
</style>
