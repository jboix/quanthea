---
/**
 * The hero's product flow, built in HTML and SVG: a question streams in, the agent's plan ticks
 * off its test runs, and the chart draws itself on a pinned dashboard. The markup is the final
 * state; `scripts/motion.ts` plays it once when motion is allowed. The data is made up, in the
 * shape of the demo's checkout incident.
 */
import { linePath, type PlotArea, scale } from '../lib/chart-geometry.ts';

/** Checkout's 5xx share, in percent, every 5 minutes from 13:00 to 15:00. */
const errorRate = [
  0.6, 0.5, 0.7, 0.6, 0.5, 0.6, 0.7, 0.6, 0.5, 0.6, 0.7, 2.4, 4.1, 4.8, 4.5, 4.9, 3.2, 1.4, 0.8,
  0.6, 0.7, 0.5, 0.6, 0.6, 0.5,
];

/** Checkout's p95 latency, in milliseconds, at the same times. */
const latency = [
  210, 205, 220, 215, 208, 212, 218, 214, 209, 216, 224, 520, 860, 980, 940, 1010, 700, 380, 260,
  225, 218, 212, 215, 210, 208,
];

/** The plot area, inside a 340 × 168 view box. */
const area: PlotArea = { left: 34, right: 306, top: 14, bottom: 138 };

/** Minutes after 13:00 to an x position. */
const atMinute = (minutes: number) => scale(minutes, [0, 120], [area.left, area.right]);

const errorPath = linePath(errorRate, area, [0, 6]);
const latencyPath = linePath(latency, area, [0, 1200]);
const gridLines = [0, 2, 4, 6].map((value) => ({
  y: scale(value, [0, 6], [area.bottom, area.top]),
  label: `${value}%`,
}));
const timeTicks = [0, 30, 60, 90, 120].map((minutes) => ({
  x: atMinute(minutes),
  label: `${13 + Math.floor(minutes / 60)}:${String(minutes % 60).padStart(2, '0')}`,
}));
const markers = [
  { x: atMinute(52), label: 'deploy v2.14', anchor: 'end', offset: -4 },
  { x: atMinute(78), label: 'rollback', anchor: 'start', offset: 4 },
];

/** The plan's panels and their queries, as the agent proposes them. */
const plan = [
  {
    title: 'Checkout error rate',
    query: 'sum(rate(http_requests_total{service="checkout",code=~"5.."}[5m]))',
    ran: '212 ms',
  },
  {
    title: 'p95 latency',
    query: 'histogram_quantile(0.95, rate(http_duration_bucket{service="checkout"}[5m]))',
    ran: '148 ms',
  },
  { title: 'Deploys', query: "select at, version from deploys where service = 'checkout'", ran: '9 ms' },
];
---

<div class="flow" data-flow>
  <div class="window card">
    <div class="titlebar">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="mono">thread · checkout</span>
    </div>
    <div class="body">
      <p class="bubble">
        <span class="visually-hidden">You ask: </span>
        <span data-stream>What happened to checkout yesterday around 14:00?</span>
      </p>
      <div class="agent" data-step="350">
        <span class="pill thinking"><span class="pulse" aria-hidden="true"></span>thinking…</span>
        <span class="pill ready">plan ready · 3 queries test-ran</span>
      </div>
      <div class="plan card" data-step="700">
        <p class="plan-title">Plan · 3 panels</p>
        <ol>
          {
            plan.map((panel, index) => (
              <li data-step={index === 0 ? '500' : '420'}>
                <span class="panel-title">{panel.title}</span>
                <code>{panel.query}</code>
                <span class="pill pill-ok">
                  <span aria-hidden="true">✓</span> query ran · {panel.ran}
                </span>
              </li>
            ))
          }
        </ol>
      </div>
      <figure class="panel card chart-step" data-step="500">
        <figcaption>
          <span class="panel-title">Checkout errors</span>
          <span class="legend">
            <span class="key key-accent">5xx %</span>
            <span class="key key-series">p95 latency</span>
          </span>
        </figcaption>
        <svg
          viewBox="0 0 340 168"
          role="img"
          aria-label="Checkout's error rate and p95 latency from 13:00 to 15:00: flat, a spike after the 13:52 deploy, falling after the 14:18 rollback."
        >
          {
            gridLines.map((line) => (
              <g>
                <line class="grid" x1={area.left} x2={area.right} y1={line.y} y2={line.y} />
                <text class="tick" x={area.left - 6} y={line.y + 3} text-anchor="end">
                  {line.label}
                </text>
              </g>
            ))
          }
          {
            timeTicks.map((tick) => (
              <text class="tick" x={tick.x} y={area.bottom + 16} text-anchor="middle">
                {tick.label}
              </text>
            ))
          }
          {
            markers.map((marker) => (
              <g class="marker">
                <line x1={marker.x} x2={marker.x} y1={area.top - 4} y2={area.bottom} />
                <text x={marker.x + marker.offset} y={area.top + 4} text-anchor={marker.anchor}>
                  {marker.label}
                </text>
              </g>
            ))
          }
          <path class="line line-series" d={latencyPath} pathLength="1"></path>
          <path class="line line-accent" d={errorPath} pathLength="1"></path>
        </svg>
        <div class="panel-foot">
          <span class="pill">3 panels · last 2 h, yesterday</span>
          <span class="pin">Pinned</span>
        </div>
      </figure>
    </div>
  </div>
</div>

<style>
  .flow {
    position: relative;
  }

  .window {
    overflow: hidden;
    box-shadow: 0 24px 48px -32px color-mix(in srgb, var(--color-ink) 45%, transparent);
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-muted);
    color: var(--color-ink-secondary);
    font-size: 12px;
  }

  .dots {
    display: inline-flex;
    gap: 6px;
  }

  .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-border-control);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    padding: 16px;
  }

  .bubble {
    justify-self: end;
    max-width: 85%;
    margin: 0;
    padding: 9px 14px;
    border-radius: 14px 14px 4px 14px;
    background: var(--color-accent-soft);
    border: 1px solid var(--color-accent-border);
    font-size: 15px;
  }

  .agent {
    display: flex;
  }

  .pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .plan {
    padding: 12px 14px;
    border-radius: var(--radius-card);
  }

  .plan-title {
    margin: 0 0 8px;
    font-size: 13px;
    font-weight: 600;
  }

  ol {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ol li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2px 12px;
    align-items: center;
  }

  .panel-title {
    font-size: 13px;
    font-weight: 500;
  }

  ol code {
    grid-column: 1;
    overflow: hidden;
    color: var(--color-ink-secondary);
    font-size: 11px;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  ol .pill {
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  .panel {
    margin: 0;
    padding: 12px 14px 10px;
    border-radius: var(--radius-card);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
  }

  .legend {
    display: inline-flex;
    gap: 12px;
    color: var(--color-ink-secondary);
    font-size: 12px;
  }

  .key::before {
    content: "";
    display: inline-block;
    width: 12px;
    height: 2px;
    margin-right: 6px;
    vertical-align: middle;
    background: currentColor;
  }

  .key-accent::before {
    background: var(--color-accent);
  }

  .key-series::before {
    background: var(--color-series-2);
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 6px;
    overflow: visible;
  }

  .grid {
    stroke: var(--color-border);
    stroke-width: 1;
  }

  .tick,
  .marker text {
    fill: var(--color-ink-secondary);
    font-family: var(--font-mono);
    font-size: 10px;
    font-variant-numeric: tabular-nums;
  }

  .marker line {
    stroke: var(--color-ink-secondary);
    stroke-dasharray: 3 3;
    stroke-width: 1;
  }

  .line {
    fill: none;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .line-accent {
    stroke: var(--color-accent);
  }

  .line-series {
    stroke: var(--color-series-2);
    stroke-width: 1.5;
  }

  .panel-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
  }

  .pin {
    display: inline-block;
    text-align: center;
    min-width: 76px;
    padding: 5px 14px;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-control);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: 13px;
    font-weight: 500;
  }

  /* While the flow plays, later steps wait out of sight and keep their room. */
  :global(:root[data-motion="on"]) .flow:not(.is-done) [data-step]:not(.is-shown) {
    visibility: hidden;
  }

  :global(:root[data-motion="on"]) .flow:not(.is-playing) [data-stream] {
    visibility: hidden;
  }

  :global(:root[data-motion="on"]) .line {
    stroke-dasharray: 1;
    transition: stroke-dashoffset 1.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(:root[data-motion="on"]) .flow:not(.is-done) .chart-step:not(.is-shown) .line {
    stroke-dashoffset: 1;
  }

  :global(:root[data-motion="on"]) .pulse {
    animation: pulse 1.2s ease-in-out infinite;
  }

  .thinking {
    display: none;
  }

  :global(:root[data-motion="on"]) .flow:not(.is-done) .thinking {
    display: inline-flex;
  }

  :global(:root[data-motion="on"]) .flow:not(.is-done) .ready {
    display: none;
  }

  [data-stream] :global(.token) {
    position: relative;
  }

  [data-stream].is-streaming :global(.token:not(.is-on)) {
    visibility: hidden;
  }

  [data-stream].is-streaming :global(.token.caret::after) {
    content: "";
    position: absolute;
    right: -3px;
    bottom: 0.1em;
    width: 2px;
    height: 1.1em;
    background: var(--color-ink);
    animation: caret 0.8s steps(1) infinite;
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  @keyframes pulse {
    50% {
      opacity: 0.25;
    }
  }


  @media (max-width: 480px) {
    .body {
      padding: 12px;
    }

    ol code {
      display: none;
    }
  }
</style>

<script>
  import { playFlow } from '../scripts/motion.ts';

  const flow = document.querySelector<HTMLElement>('[data-flow]');
  if (flow) playFlow(flow);
</script>
