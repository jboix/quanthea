---
/**
 * The version of the docs shown, and the others: a menu at the top of the docs navigation, each
 * entry leading to the same page in that version, or to its docs home when it lacks the page. A
 * `<details>` opens and closes it without script; a script closes it on a press outside or Escape.
 */
import type { DocVersion } from '../lib/versions.ts';

/** A version in the menu, with where it leads from this page. */
export interface VersionLink {
  /** The version. */
  readonly version: DocVersion;
  /** The address of this page in it, or of its docs home. */
  readonly href: string;
}

/** Props of the menu. */
interface Props {
  /** The version shown. */
  current: DocVersion;
  /** Every version, in order. */
  links: readonly VersionLink[];
}

const { current, links } = Astro.props;
---

<details class="versions" data-versions>
  <summary aria-label={`Docs version: ${current.id}, ${current.note}. Choose another.`}>
    <span class="choice">
      <span class="name">{current.id}</span>
      <span class="note">{current.note}</span>
    </span>
    <svg class="chevron" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
      <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"></path>
    </svg>
  </summary>
  <ul class="menu">
    {
      links.map(({ version, href }) => (
        <li>
          <a href={href} aria-current={version.id === current.id ? 'page' : undefined}>
            <span class="choice">
              <span class="name">{version.id}</span>
              <span class="note">{version.note}</span>
            </span>
            {version.id === current.id && (
              <svg class="check" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.8" />
              </svg>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script>
  import { wireVersionMenus } from '../scripts/version-menu.ts';

  wireVersionMenus();
</script>

<style>
  /* Like the navigation's links, the box steps out by 10px, so its text lines up with theirs. */
  .versions {
    position: relative;
    margin-left: -10px;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 12px 8px 9px;
    border: 1px solid var(--color-border-control);
    border-radius: var(--radius-control);
    background: var(--color-surface);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    border-color: var(--color-accent-border);
  }

  summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .chevron {
    flex-shrink: 0;
    color: var(--color-ink-secondary);
    transition: transform 0.15s;
  }

  .versions[open] .chevron {
    transform: rotate(180deg);
  }

  .choice {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
  }

  .name {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .note {
    font-size: 12px;
    color: var(--color-ink-secondary);
  }

  .menu {
    position: absolute;
    z-index: 5;
    top: calc(100% + 6px);
    right: 0;
    left: 0;
    margin: 0;
    padding: 4px;
    list-style: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: 0 10px 28px rgb(0 0 0 / 14%);
  }

  .menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 7px 10px;
    border-radius: var(--radius-control);
    text-decoration: none;
  }

  .menu a:hover,
  .menu a:focus-visible {
    background: var(--color-surface-muted);
    outline: none;
  }

  .check {
    flex-shrink: 0;
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .chevron {
      transition: none;
    }
  }
</style>
