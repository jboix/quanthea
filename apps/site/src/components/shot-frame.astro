---
/**
 * A screenshot in a window frame, taken in both schemes: the light shot shows in the light scheme,
 * the dark shot in the dark one.
 */
import type { ImageMetadata } from 'astro';

/** Props of the frame. */
interface Props {
  /** The light scheme's screenshot, imported from `docs/screenshots/<name>-light.webp`. */
  light: ImageMetadata;
  /** The dark scheme's screenshot, imported from `docs/screenshots/<name>-dark.webp`. */
  dark: ImageMetadata;
  /** What the screenshot shows. */
  alt: string;
  /** `eager` for a shot in the first screen. */
  loading?: 'lazy' | 'eager';
}

const { light, dark, alt, loading = 'lazy' } = Astro.props;
const shots = [
  { image: light, scheme: 'on-light' },
  { image: dark, scheme: 'on-dark' },
];
---

<figure class="shot">
  <div class="chrome" aria-hidden="true"><i></i><i></i><i></i></div>
  {
    shots.map(({ image, scheme }) => (
      <img
        class={scheme}
        src={image.src}
        width={image.width}
        height={image.height}
        alt={alt}
        loading={loading}
        decoding="async"
      />
    ))
  }
</figure>

<style>
  .shot {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-panel);
    background: var(--color-surface);
    box-shadow: 0 20px 40px -28px color-mix(in srgb, var(--color-ink) 50%, transparent);
  }

  .chrome {
    display: flex;
    gap: 6px;
    padding: 9px 12px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-muted);
  }

  .chrome i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-border-control);
  }

  img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
