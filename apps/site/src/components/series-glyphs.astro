---
/**
 * The chart series types of the spec as a strip of tiny glyphs, each with its name, from
 * `facts.ts`.
 */
import { seriesTypes } from '../data/facts.ts';

/** The shapes of each glyph, on a 24 × 18 grid: paths stroked, then circles filled. */
const glyphs: Record<string, { paths: string[]; dots?: [number, number, number][] }> = {
  line: { paths: ['M2 14 L7 9 L11 11 L16 5 L22 7'] },
  bar: { paths: ['M5 16 V9', 'M10 16 V4', 'M15 16 V11', 'M20 16 V7'] },
  scatter: {
    paths: [],
    dots: [
      [5, 12, 1.6],
      [9, 7, 1.6],
      [13, 11, 1.6],
      [17, 5, 1.6],
      [20, 10, 1.6],
    ],
  },
  pie: { paths: ['M12 9 V2 A7 7 0 1 1 5.9 12.5 Z', 'M12 9 L5.9 12.5'] },
  heatmap: { paths: ['M3 3 H21 V15 H3 Z', 'M9 3 V15', 'M15 3 V15', 'M3 9 H21'] },
  gauge: { paths: ['M4 14 A8 8 0 0 1 20 14', 'M12 14 L16 8'] },
  boxplot: { paths: ['M8 5 H16 V13 H8 Z', 'M8 9 H16', 'M12 1.5 V5', 'M12 13 V16.5'] },
  candlestick: { paths: ['M7 3 V15', 'M5 6 H9 V12 H5 Z', 'M17 2 V12', 'M15 4 H19 V9 H15 Z'] },
  treemap: { paths: ['M3 3 H21 V15 H3 Z', 'M13 3 V15', 'M13 9 H21', 'M3 10 H13'] },
  sunburst: { paths: ['M12 9 m-3 0 a3 3 0 1 0 6 0 a3 3 0 1 0 -6 0', 'M12 1.5 A7.5 7.5 0 0 1 19.5 9'] },
  sankey: { paths: ['M3 4 C12 4 12 13 21 13', 'M3 13 C12 13 12 6 21 6', 'M3 4 V2', 'M21 13 V16'] },
  graph: {
    paths: ['M5 13 L11 5 L19 9 L13 15 Z', 'M11 5 L13 15'],
    dots: [
      [5, 13, 1.8],
      [11, 5, 1.8],
      [19, 9, 1.8],
      [13, 15, 1.8],
    ],
  },
  funnel: { paths: ['M3 3 H21 L15 10 V16 H9 V10 Z'] },
  radar: { paths: ['M12 2 L20 8 L17 16 H7 L4 8 Z', 'M12 5 L17 9 L14 13 H9 L7 9 Z'] },
  parallel: { paths: ['M4 2 V16', 'M12 2 V16', 'M20 2 V16', 'M4 5 L12 12 L20 6', 'M4 12 L12 6 L20 13'] },
  map: { paths: ['M3 6 L8 3 L14 5 L20 3 L21 12 L15 15 L9 13 L4 15 Z'] },
};

const items = seriesTypes.map((series) => ({ ...series, glyph: glyphs[series.type] }));
---

<ul class="glyphs" aria-label="Chart series types">
  {
    items.map((item) => (
      <li>
        <svg viewBox="0 0 24 18" width="28" height="21" aria-hidden="true">
          {item.glyph?.paths.map((path) => <path d={path} />)}
          {item.glyph?.dots?.map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={r} />)}
        </svg>
        <span class="mono">{item.name}</span>
      </li>
    ))
  }
</ul>

<style>
  .glyphs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(64px, 1fr));
    gap: 10px 6px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    justify-items: center;
    gap: 4px;
    color: var(--color-accent);
  }

  path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  circle {
    fill: currentColor;
  }

  span {
    color: var(--color-ink-secondary);
    font-size: 10px;
    text-align: center;
  }
</style>
