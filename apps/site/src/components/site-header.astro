---
/**
 * The site header: the logo for the scheme shown, a search and a menu when the page gives them
 * (the docs), the navigation, and the scheme toggle. On a narrow doc page the menu holds the
 * navigation, and the search is a magnifier. The GitHub link carries the star count when the build
 * could fetch it.
 */
import iconTile from '../../../../docs/brand/quanthea-icon.svg';
import logoOnLight from '../../../../docs/brand/quanthea-logo.svg';
import logoOnDark from '../../../../docs/brand/quanthea-logo-dark.svg';
import { starCount } from '../lib/github-stars.ts';
import { repositoryUrl } from '../lib/project.ts';
import { link } from '../lib/url.ts';
import ThemeToggle from './theme-toggle.astro';

/** Props of the header. */
interface Props {
  /** The section the page belongs to, marked as current in the navigation. */
  current?: 'docs' | 'pricing';
}

const { current } = Astro.props;
const hasSearch = Astro.slots.has('search');
const stars = await starCount();
---

<header class="site-header">
  <div class="container bar">
    <a class="home" href={link()}>
      <img class="logo on-light" src={logoOnLight.src} alt="quanthea" width="129" height="32" />
      <img class="logo on-dark" src={logoOnDark.src} alt="quanthea" width="129" height="32" />
      <img class="tile" src={iconTile.src} alt="quanthea" width="32" height="32" />
    </a>
    {
      hasSearch && (
        <div class="search-slot">
          <slot name="search" />
        </div>
      )
    }
    <nav aria-label="Main">
      <ul>
        <li class="features"><a href={link('#features')}>Features</a></li>
        <li>
          <a href={link('docs/')} aria-current={current === 'docs' ? 'page' : undefined}>Docs</a>
        </li>
        <li>
          <a href={link('pricing/')} aria-current={current === 'pricing' ? 'page' : undefined}>
            Pricing
          </a>
        </li>
        <li>
          <a class="github" href={repositoryUrl}>
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              ></path>
            </svg>
            <span class="github-label">GitHub</span>
            {
              stars && (
                <span class="stars num">
                  {stars}
                  <span class="visually-hidden">stars</span>
                </span>
              )
            }
          </a>
        </li>
      </ul>
    </nav>
    <ThemeToggle />
    {
      Astro.slots.has('menu') && (
        <div class="menu-slot">
          <slot name="menu" />
        </div>
      )
    }
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--color-ground) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 64px;
  }

  .home {
    display: flex;
    align-items: center;
    margin-right: auto;
  }

  .logo {
    height: 32px;
    width: auto;
  }

  /* With a search, it follows the logo and takes the room the logo's margin took. */
  .bar:has(.search-slot) .home {
    margin-right: 0;
  }

  .search-slot {
    flex: 0 1 380px;
    margin: 0 auto 0 24px;
  }

  .tile {
    display: none;
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 8px 10px;
    border-radius: var(--radius-control);
    color: var(--color-ink-label);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-ink);
    background: var(--color-surface);
  }

  nav a[aria-current="page"] {
    color: var(--color-accent);
  }

  .stars {
    padding: 0 6px;
    border-radius: var(--radius-pill);
    background: var(--color-surface-muted);
    border: 1px solid var(--color-border);
    color: var(--color-ink-secondary);
    font-size: 12px;
  }

  /* A narrow doc page: the search shrinks to its magnifier and the menu takes the navigation. */
  @media (max-width: 860px) {
    .bar:has(.search-slot) .home {
      margin-right: auto;
    }

    .search-slot {
      flex: none;
      margin: 0;
    }

    .bar:has(.menu-slot) nav {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .features {
      display: none;
    }

    /* The label stays for screen readers. */
    .github-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .bar {
      gap: 8px;
    }

    nav a {
      padding: 8px;
    }
  }

  @media (max-width: 420px) {
    .home .logo {
      display: none;
    }

    .tile {
      display: block;
    }
  }
</style>
