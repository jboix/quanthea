{
  "name": "querent",
  "version": "0.0.0",
  "private": true,
  "description": "Describe a dashboard in a chat, an agent builds it against your data sources, pin the good ones.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "dev"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter @querent/web build",
    "start": "bun apps/server/src/main.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "docs:check": "remark . --quiet --frail --use ./scripts/remark-check-formatted.mjs",
    "docs:format": "remark . --quiet --output",
    "arch": "depcruise apps packages --config .dependency-cruiser.cjs",
    "arch:graph": "depcruise apps packages --config .dependency-cruiser.cjs --include-only '^(apps|packages)' --output-type dot | dot -T svg > dependency-graph.svg",
    "knip": "knip",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=coverage",
    "verify": "bun run lint && bun run docs:check && bun run arch && bun run knip && bun run typecheck && bun run test && bun run build",
    "prepare": "husky",
    "env:up": "docker compose -f dev/docker-compose.yml up -d --wait postgres prometheus",
    "env:up:opensearch": "docker compose -f dev/docker-compose.yml --profile opensearch up -d --wait",
    "env:stop": "docker compose -f dev/docker-compose.yml --profile opensearch stop",
    "env:down": "docker compose -f dev/docker-compose.yml --profile opensearch down -v",
    "test:integration": "QUERENT_INTEGRATION=1 bun test integration"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@semantic-release/git": "^11.0.1",
    "@types/bun": "1.3.14",
    "dependency-cruiser": "^18.4.0",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "remark-cli": "^12.0.1",
    "remark-gfm": "^4.0.1",
    "remark-validate-links": "^13.1.0",
    "semantic-release": "^25.0.9",
    "typescript": "~6.0.3"
  },
  "license": "MIT",
  "author": "Josep Boix Requesens",
  "homepage": "https://github.com/jboix/querent#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jboix/querent.git"
  },
  "bugs": {
    "url": "https://github.com/jboix/querent/issues"
  }
}
